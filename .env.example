# Copy to .env and adjust. Vite only exposes variables prefixed with VITE_ to the browser,
# so a bare FRONTEND_DOMAIN would be readable by the build tooling and invisible to the
# app -- every name here keeps the prefix on purpose. Both are read in src/config.js.
#
# These are read at BUILD time and inlined into dist/, not read at runtime: the bundle
# nginx serves carries whatever values were set when `npm run build` ran. Changing one
# means rebuilding. The Docker image does not pick this file up -- .dockerignore excludes
# .env and .env.* -- so a container build passes them as build args instead, which
# Dockerfile and docker-compose.yml already declare.

# Where src/api/client.js sends every request, including the /api prefix.
#
# An absolute URL talks to the backend directly and no reverse proxy is involved at all:
# nothing has to forward /api, and the Vite proxy in vite.config.js goes unused. The cost
# is that the two halves are then different origins, so the backend must allow this one --
# CORS_ORIGIN in its .env, which is `*` by default and already works for the Bearer token
# this app sends. Keep the host spelling the browser will use: with the backend on
# HOST=localhost, Node binds only the IPv6 loopback, and 127.0.0.1 will not reach it.
#
# The bare path "/api" is the other arrangement: same origin, CORS never applies, and the
# forwarding is somebody's job -- Vite's proxy in dev, an /api location in nginx in
# production, which nginx.conf does not have yet.
VITE_API_URL=http://localhost:3000/api

# This app's own public origin, used to build links that point back here: the activation
# link handed to someone who was just invited, and anything else shared outside the app.
# No trailing slash. Unset, src/config.js falls back to the origin the page was opened
# from, which is right until something has to mint a link from somewhere else.
#
# It must match FRONTEND_DOMAIN in the backend's .env, which pins the value into session
# tokens as `aud` and re-checks it on every verification -- a mismatch rejects tokens
# rather than degrading quietly.
VITE_FRONTEND_DOMAIN=http://localhost:5173
